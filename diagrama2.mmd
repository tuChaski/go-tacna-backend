
graph LR
    %% Configuración de orientación Izquierda a Derecha
    direction LR

    %% Definición de Actores
    cli((Cliente))
    admin((Administrador))
    banco((Pasarela de Pago))

    %% Caja del Sistema
    subgraph Sistema ["Sistema de Tienda Online"]
        UC1(Iniciar Sesión)
        UC2(Buscar Productos)
        UC3(Realizar Compra)
        UC4(Pagar con Tarjeta)
        UC5(Aplicar Cupón de Descuento)
        admin_UC(Gestionar Inventario)
    end

    %% Relaciones de los Actores
    cli --> UC1
    cli --> UC2
    cli --> UC3
    admin --> admin_UC

    %% Relaciones de Inclusión (Líneas punteadas)
    UC3 -.->|&lt;&lt;include&gt;&gt;| UC1
    UC3 -.->|&lt;&lt;include&gt;&gt;| UC4

    %% Relaciones de Extensión (Línea punteada)
    UC5 -.->|&lt;&lt;extend&gt;&gt;| UC3

    %% Conexión con sistema externo
    UC4 --> banco

    %% Estilos visuales para diferenciar Actores de Casos de Uso
    style cli fill:#f9f,stroke:#333,stroke-width:2px
    style admin fill:#f9f,stroke:#333,stroke-width:2px
    style banco fill:#bbf,stroke:#333,stroke-width:2px

